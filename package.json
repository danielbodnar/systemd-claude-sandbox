{
  "name": "systemd-claude-sandbox",
  "private": true,
  "workspaces": [
    "mcp-tunnel",
    "site",
    "backends/cloudflare"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run typecheck && bun run test && bun run docs:build",
    "dev": "just tunnel-dev",
    "test": "bun run --filter mcp-tunnel test",
    "typecheck": "bun run --filter mcp-tunnel typecheck && bun run --filter claude-sandbox-cf typecheck",
    "docs:build": "bun run --filter site build",
    "docs:dev": "bun run --filter site dev",
    "tapes": "just tapes",
    "deploy": "just deploy",
    "publish": "just publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "syncpack": "^15.3.2",
    "wrangler": "^4.118.0"
  }
}
