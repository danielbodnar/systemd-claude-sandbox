{
  // MCP tunnel configuration. Routes map public path segments to MCP
  // servers on the compose sandbox network. Each upstream must speak MCP
  // Streamable HTTP.
  "listen": { "hostname": "0.0.0.0", "port": 8787 },
  "routes": [
    // Example: uncomment the mcp-filesystem service in compose.yaml first.
    // { "name": "filesystem", "upstream": "http://mcp-filesystem:9101/mcp" }
    { "name": "example", "upstream": "http://mcp-example:9100/mcp" }
  ],
  // Publish transport. "none" keeps the listener local. "cloudflared" is
  // the proposed default but requires both this setting and the
  // --enable-cloudflared flag until the decision record is accepted.
  "transport": { "kind": "none" }
}
