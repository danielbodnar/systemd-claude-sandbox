# Copy to .env and fill in. Only the environment key belongs on this host.
# Do NOT set ANTHROPIC_API_KEY here; the worker must never hold an
# organization-scoped credential.

# Console-generated environment key (sk-ant-oat01-...) and environment id
# for the self_hosted environment.
ANTHROPIC_ENVIRONMENT_KEY=
ANTHROPIC_ENVIRONMENT_ID=

# Optional API base override, passed through to workers only if set.
ANTHROPIC_BASE_URL=

# Local port the MCP tunnel listens on (loopback only).
MCP_TUNNEL_PORT=8787

# Required only when the cloudflared profile is enabled.
CLOUDFLARE_TUNNEL_TOKEN=
